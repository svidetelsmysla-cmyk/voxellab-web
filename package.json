{
  "name": "@voxellab/public-web-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "suite:build": "vite build --ssr scripts/runSceneSuite.ts --outDir .suite-build --emptyOutDir",
    "suite": "pnpm suite:build && node .suite-build/runSceneSuite.js",
    "cavity:build": "vite build --ssr scripts/runCavityRelaxationGate.ts --outDir .cavity-build --emptyOutDir",
    "cavity:gate": "pnpm cavity:build && node .cavity-build/runCavityRelaxationGate.js",
    "a4:build": "vite build --ssr scripts/runContinuousFieldActionBridgeGate.ts --outDir .a4-build --emptyOutDir",
    "a4:gate": "pnpm a4:build && node .a4-build/runContinuousFieldActionBridgeGate.js",
    "benchmark:browser": "node scripts/runBrowserPerformance.mjs",
    "equilibrium:gate": "vitest run tests/equilibriumGpuMath.test.ts tests/equilibriumGpuBranches.test.ts tests/equilibriumGpuPacket.test.ts",
    "equilibrium:e2e": "playwright test tests/e2e/equilibrium-regime-map.spec.ts",
    "equilibrium:timeline:build": "vite build --ssr scripts/buildEquilibriumRootTimeline.ts --outDir .equilibrium-timeline-build --emptyOutDir && node .equilibrium-timeline-build/buildEquilibriumRootTimeline.js",
    "equilibrium:webgpu:gate": "playwright test --config playwright.webgpu.config.ts"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/three": "^0.179.0",
    "@webgpu/types": "^0.1.64",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
